# TypeMeter Security Configuration Example
# Copy this file to .env and fill in the values.

# Flask Application Key (secret, cryptographically random, used to sign session cookies)
# REQUIRED in production mode (ENV=production).
# Generate one using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_this_with_a_secure_random_key_of_at_least_32_chars

# Environment setting (production requires HTTPS/Secure cookies & SECRET_KEY; development allows HTTP)
ENV=development

# Managed Database Connection String (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
# Leave empty to default to local SQLite database (typemeter.db)
DATABASE_URL=

# Google OAuth 2.0 Credentials
# Register your application in Google Cloud Console and set redirect URL to:
# http://127.0.0.1:8000/auth/google/callback (in local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Brevo HTTPS Transactional Email API Settings
# Render free and paid tiers block outbound SMTP ports (25, 465, 587).
# TypeMeter delivers transactional emails via Brevo HTTPS API (port 443).
BREVO_API_KEY=
SMTP_FROM=typemeterofficial@gmail.com
SMTP_FROM_NAME=TypeMeter

# Legacy SMTP Email Settings (Disabled on Render due to platform SMTP port blocks)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
